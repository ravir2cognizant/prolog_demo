# Base URL for the BFF API. Vite reads import.meta.env.VITE_API_BASE_URL.
VITE_API_BASE_URL=http://localhost:4000
# For staging/prod: e.g. https://api.admin.staging.example.com

# Toggle Mock Service Worker. With 1, the SPA boots fully offline using msw-handlers.ts.
VITE_USE_MSW=1
# For staging/prod: VITE_USE_MSW=0 (always hit the real BFF)

# Dev-only bearer token. Only valid against the BFF in AUTH_DEV_BYPASS=1 mode.
VITE_DEV_TOKEN=dev-token
# For staging/prod: remove this; the SPA must obtain a real token from the auth provider
