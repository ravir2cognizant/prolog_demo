# Node runtime mode -- 'development' enables AUTH_DEV_BYPASS=1 safely
NODE_ENV=development
# For staging/prod: NODE_ENV=production

# HTTP port the BFF listens on
PORT=4000
# For staging/prod: set per environment

# CORS allow-list (comma-separated origins)
CORS_ORIGIN=http://localhost:5173
# For staging/prod: set to your frontend domain(s), comma-separated

# JSON body parser size limit (e.g. 100kb, 1mb)
BODY_LIMIT=100kb
# For staging/prod: keep at or below default unless your payloads require more

# Pino log level (trace|debug|info|warn|error|fatal)
LOG_LEVEL=info
# For staging/prod: LOG_LEVEL=info (avoid debug/trace in production)

# Dev-only bypass for the JWT authentication middleware.
# Any non-empty Authorization: Bearer ... is accepted and mapped to a stub principal.
AUTH_DEV_BYPASS=1
# For staging/prod: AUTH_DEV_BYPASS=0 and configure JWKS_URI

# JWKS endpoint for production JWT verification (jose remote JWKS)
JWKS_URI=
# For staging/prod: https://<idp>/.well-known/jwks.json

# Expected JWT issuer claim
JWT_ISSUER=
# For staging/prod: https://<idp>/issuer

# Expected JWT audience claim
JWT_AUDIENCE=
# For staging/prod: prologue-bff

# OpenTelemetry OTLP endpoint. Leave blank in dev -- the OTel init is a safe no-op when empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
# For staging/prod: e.g. https://otel-collector:4317

# Enable the public /api-docs HTML inventory endpoint.
ENABLE_API_DOCS=1
# For staging/prod: ENABLE_API_DOCS=0 (or omit) to disable the inventory endpoint
