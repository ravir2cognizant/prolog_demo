# Prologue BFF -- environment variables
# Copy to .env and adjust. Dev defaults work out of the box.

# Server
PORT=4000
# For staging/prod: match your container port mapping

# CORS -- comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173
# For staging/prod: set to your frontend domain(s), comma-separated

# Auth -- JWT validation
# Set AUTH_DEV_BYPASS=1 to skip JWT in development (injects a full-access dev principal)
AUTH_DEV_BYPASS=1
# For staging/prod: AUTH_DEV_BYPASS=0 and configure JWKS_URI

JWKS_URI=
# For staging/prod: e.g. https://your-idp/.well-known/jwks.json

JWT_ISSUER=
# For staging/prod: e.g. https://your-idp

JWT_AUDIENCE=
# For staging/prod: e.g. prologue-bff

# Logging
LOG_LEVEL=info
# For staging/prod: warn or error

# API docs
ENABLE_API_DOCS=1
# For staging/prod: ENABLE_API_DOCS=0 to disable the endpoint inventory

# OpenTelemetry -- leave empty to disable (safe no-op)
OTEL_EXPORTER_OTLP_ENDPOINT=
# For staging/prod: e.g. http://otel-collector:4317

OTEL_SERVICE_NAME=prologue-bff
# For staging/prod: match your service registry name
