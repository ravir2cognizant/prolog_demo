# BFF base URL
VITE_API_BASE_URL=http://localhost:4000
# For staging/prod: e.g. https://api.prologue.example.com

# Enable MSW mock service worker (1 = mocks, 0 = real BFF)
VITE_USE_MSW=1
# For staging/prod: VITE_USE_MSW=0

# Dev token injected into Authorization header (only valid when BFF has AUTH_DEV_BYPASS=1)
VITE_DEV_TOKEN=dev-token
# For staging/prod: remove this; obtain a real token from the auth provider
